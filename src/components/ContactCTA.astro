---
interface Props { title?: string; copy?: string; }
const { title = 'Bring us the decision.', copy = 'Tell us what is happening, what matters most and when you need to move. We will help you identify the legal path forward.' } = Astro.props;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <img class="contact-image" src="/images/dubai-office.webp" alt="Dubai office interior overlooking the skyline" loading="lazy" /><div class="contact-scrim"></div>
  <div><h2 id="contact-title" data-reveal>{title}</h2><p data-reveal>{copy}</p></div>
  <a class="primary-action primary-action--dark" data-reveal href="mailto:hello@baylinelegal.ae?subject=Confidential%20consultation%20request&body=Hello%20Bayline%20Legal%2C%0A%0AI%27d%20like%20to%20discuss%3A%0A%0AMy%20preferred%20contact%20details%20are%3A%0A">Request a consultation <svg class="action-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg></a>
</section>
