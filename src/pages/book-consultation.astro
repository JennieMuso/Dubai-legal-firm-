---
import InnerLayout from '../layouts/InnerLayout.astro';
import '../styles/consultation.css';
---
<InnerLayout title="Book a Consultation | Bayline Legal Dubai" description="Tell Bayline Legal about your Dubai business law matter and request a consultation.">
  <section class="consult-hero"><div><h1 data-hero-reveal>Tell us what you need to decide.</h1><p>Share a few details about your matter. We will use them to prepare the first conversation and identify the right practice focus.</p></div><img src="/images/commercial-agreement.webp" alt="Commercial documents under review" fetchpriority="high" /></section>
  <section class="inner-section consult-layout"><div class="consult-aside"><h2 data-text-reveal>A useful first conversation starts with context.</h2><p>Tell us the objective, timing and documents involved. Please avoid sending confidential documents until the firm confirms how to share them securely.</p><div class="consult-note"><strong>What happens next</strong><p>Submitting this form opens an email draft in your email app. Review and send it to complete your request.</p></div></div>
    <form id="consult-form" class="consult-form"><h2>Request a consultation</h2><p>Fields marked * are required.</p>
      <div class="form-row"><label>Full name *<input name="name" type="text" placeholder="Your full name" autocomplete="name" required /></label><label>Email address *<input name="email" type="email" placeholder="you@company.com" autocomplete="email" required /></label></div>
      <div class="form-row"><label>Phone number<input name="phone" type="tel" placeholder="+971 50 000 0000" autocomplete="tel" /></label><label>Company or organisation<input name="company" type="text" placeholder="Company name (optional)" autocomplete="organization" /></label></div>
      <div class="form-row"><label>Practice area *<select name="practice" required><option value="" disabled selected>Select a practice area</option><option>Corporate & commercial</option><option>Commercial disputes</option><option>Real estate & construction</option><option>Employment & mobility</option><option>Not sure yet</option></select></label><label>Preferred consultation format<select name="format"><option value="" selected>Select a format</option><option>Phone call</option><option>Video call</option><option>In person in Dubai</option></select></label></div>
      <label>Preferred lawyer<input name="lawyer" type="text" placeholder="Lawyer's name (optional)" /></label>
      <label>Briefly describe your matter *<textarea name="matter" rows="6" placeholder="What is happening, what outcome do you need, and when do you need to move?" required></textarea></label>
      <label>Preferred time to speak<input name="time" type="text" placeholder="For example, weekday mornings GST" /></label>
      <button class="primary-action primary-action--green" type="submit">Prepare email request <svg class="action-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg></button><p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</InnerLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#consult-form');
  const lawyer = new URLSearchParams(location.search).get('lawyer');
  if (lawyer && form) (form.elements.namedItem('lawyer') as HTMLInputElement).value = lawyer;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const fields = ['name','email','phone','company','practice','format','lawyer','matter','time'];
    const labels: Record<string,string> = {name:'Name',email:'Email',phone:'Phone',company:'Company',practice:'Practice area',format:'Preferred format',lawyer:'Preferred lawyer',matter:'Matter',time:'Preferred time'};
    const body = fields.map(key => `${labels[key]}: ${data.get(key) || 'Not provided'}`).join('\n\n');
    const subject = `Consultation request — ${data.get('practice')}`;
    const status = form.querySelector<HTMLElement>('.form-status');
    if (status) status.textContent = 'Your email app should open with the request. Please send the draft to complete your enquiry.';
    location.href = `mailto:hello@baylinelegal.ae?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
