---
import InnerLayout from '../../layouts/InnerLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { lawyers } from '../../data/lawyers';
import { lawyerProfiles } from '../../data/lawyerProfiles';
import '../../styles/profile.css';
export function getStaticPaths(){ return lawyers.map(lawyer=>({params:{slug:lawyer.slug},props:{lawyer}})); }
const { lawyer } = Astro.props;
const profile = lawyerProfiles[lawyer.slug];
---
<InnerLayout title={`${lawyer.name} | ${lawyer.role} | Bayline Legal`} description={`${lawyer.name} is ${lawyer.role} at Bayline Legal in Dubai, focusing on ${lawyer.focus.toLowerCase()}.`} active="lawyers">
  <section class="profile-hero" aria-labelledby="profile-title"><img class="profile-hero__image" src={lawyer.image} alt={`Portrait of ${lawyer.name}`} fetchpriority="high" /><div class="profile-hero__shade"></div><div class="profile-hero__content"><a href="/lawyers/">← All lawyers</a><div><span>{lawyer.role} / {lawyer.focus}</span><h1 id="profile-title" data-hero-reveal>{lawyer.name}</h1><p>{profile.summary}</p><a class="primary-action primary-action--light" href={`/book-consultation/?lawyer=${encodeURIComponent(lawyer.name)}`}>Book a consultation <svg class="action-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg></a></div></div></section>
  <section class="inner-section profile-story"><div><h2 data-text-reveal>Experience shaped by the matter.</h2></div><div>{profile.background.map(paragraph=><p>{paragraph}</p>)}</div></section>
  <section class="inner-section inner-section--forest profile-expertise"><div class="section-heading"><h2 data-text-reveal>Areas of practice.</h2><p>Connected advice within {lawyer.focus.toLowerCase()}.</p></div><div class="profile-expertise__grid" data-bento>{lawyer.areas.map((area,i)=><article><span>0{i+1}</span><h3>{area}</h3></article>)}</div></section>
  <section class="inner-section profile-credentials"><div><h2 data-text-reveal>Credentials & recognition.</h2><p>Professional background, recognition and language capability relevant to the work.</p></div><div class="profile-credential-list"><h3>Education & qualifications</h3>{profile.education.map(item=><p>{item}</p>)}<h3>Awards & recognition</h3>{profile.recognition.map(item=><p>{item}</p>)}<h3>Languages</h3><p>{profile.languages.join(' · ')}</p></div></section>
  <section class="inner-section inner-section--mist profile-quote"><blockquote>“{profile.approach}”</blockquote><p>{lawyer.name}<br />{lawyer.role}</p></section>
  <ContactCTA title={`Speak with ${lawyer.name.split(' ')[0]}.`} copy="Tell us about the decision, the deadline and the documents you have. We will help identify the right next step." />
</InnerLayout>
