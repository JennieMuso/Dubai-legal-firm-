---
import '../styles/global.css';

const services = [
  {
    title: 'Corporate transactions',
    copy: 'Company formation, shareholder arrangements, investment rounds and deals structured for the UAE market.',
    detail: 'Formation · Governance · M&A'
  },
  {
    title: 'Commercial disputes',
    copy: 'Clear early assessment, decisive strategy and representation across negotiation, arbitration and litigation.',
    detail: 'Strategy · Arbitration · Litigation'
  },
  {
    title: 'Real estate & construction',
    copy: 'Practical counsel for acquisitions, development agreements, leasing, payment claims and project disputes.',
    detail: 'Transactions · Projects · Claims'
  },
  {
    title: 'Employment & mobility',
    copy: 'Employment frameworks and cross-border mobility advice that protects the business and respects its people.',
    detail: 'Contracts · Policies · Mobility'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Commercial legal counsel for businesses and private clients in Dubai Business Bay." />
    <meta name="theme-color" content="#102c25" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23102c25%22/><path d=%22M22 20h26c18 0 29 9 29 23 0 9-5 15-13 18 10 2 16 9 16 18H62c0-7-5-11-15-11h-7v11H22V20zm18 15v18h7c8 0 12-3 12-9 0-6-4-9-12-9h-7z%22 fill=%22%23d8ff3e%22/></svg>" />
    <title>Bayline Legal — Dubai Business Bay</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Bayline Legal home">
        <svg viewBox="0 0 38 38" aria-hidden="true"><path d="M5 4h13c9 0 15 5 15 12 0 5-3 8-7 10 5 1 8 4 8 9h-9c0-4-3-6-8-6h-3v6H5V4Zm9 8v9h4c4 0 6-2 6-5s-2-4-6-4h-4Z" /></svg>
        <span>Bayline Legal</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#expertise">Expertise</a>
        <a href="#approach">Approach</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="header-action" href="mailto:hello@baylinelegal.ae?subject=Confidential%20consultation%20request">Talk to counsel</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span>Menu</span>
      </button>
      <div class="mobile-menu" id="mobile-menu" hidden>
        <a href="#expertise">Expertise</a>
        <a href="#approach">Approach</a>
        <a href="#contact">Contact</a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img src="/images/counsel.webp" alt="Two legal advisers in conversation overlooking Dubai Business Bay" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <h1 id="hero-title">Business moves.<br />Legal clarity.</h1>
          <p>Commercial legal counsel from Dubai Business Bay, built around your next decision.</p>
          <a class="text-action" href="mailto:hello@baylinelegal.ae?subject=Confidential%20consultation%20request">
            Start a confidential conversation <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-location">
          <span>Business Bay, Dubai</span>
          <span data-dubai-time>Dubai · GST</span>
        </div>
        <a class="scroll-cue" href="#position" aria-label="Scroll to introduction"><span></span>Scroll</a>
      </section>

      <section class="position" id="position" aria-labelledby="position-title">
        <div class="position-side" data-reveal>
          <p>Decisive advice for ambitious businesses, investors and private clients operating in the UAE.</p>
        </div>
        <div class="position-main">
          <h2 id="position-title" data-reveal>Counsel for decisive moments.</h2>
          <p data-reveal>We turn complex legal positions into a clear route forward. Every matter starts with the commercial reality, then the law, then the action.</p>
          <a data-reveal href="#expertise">Explore our expertise <span aria-hidden="true">↓</span></a>
        </div>
        <div class="position-mark" aria-hidden="true">BAY</div>
      </section>

      <section class="expertise" id="expertise" aria-labelledby="expertise-title">
        <div class="expertise-intro">
          <h2 id="expertise-title">Legal work.<br />Clear moves.</h2>
          <p>Four connected practice areas for the moments that shape a business.</p>
        </div>
        <div class="service-stage">
          {services.map((service, index) => (
            <article class="service-panel" style={`--panel-index:${index}`}>
              <div class="service-heading">
                <h3>{service.title}</h3>
                <span>{index + 1} of {services.length}</span>
              </div>
              <p>{service.copy}</p>
              <div class="service-detail">{service.detail}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="approach" id="approach" aria-labelledby="approach-title">
        <div class="approach-media" data-image-reveal>
          <img src="/images/team.webp" alt="Legal team reviewing a commercial agreement around a table" loading="lazy" />
        </div>
        <div class="approach-copy">
          <h2 id="approach-title" data-reveal>Close counsel.<br />Clear outcomes.</h2>
          <p data-reveal>You work directly with the lawyer responsible for the result. Advice arrives in plain language, with the decision, risk and next move visible.</p>
          <ul aria-label="How we work">
            <li data-reveal><strong>One point of contact</strong><span>Accountability stays clear from first call to final document.</span></li>
            <li data-reveal><strong>Commercial context first</strong><span>We understand the deal before we shape the legal answer.</span></li>
            <li data-reveal><strong>Built around your deadline</strong><span>The work plan responds to the pace of the decision.</span></li>
          </ul>
        </div>
      </section>

      <section class="place" aria-labelledby="place-title">
        <img src="/images/business-bay.webp" alt="Green glass architecture beside the Dubai canal in Business Bay" loading="lazy" />
        <div class="place-copy">
          <h2 id="place-title">Dubai insight.<br />Global pace.</h2>
          <p>Based in Business Bay and positioned for work that crosses industries, borders and time zones.</p>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <p data-reveal>Have a decision in front of you?</p>
        <h2 id="contact-title" data-reveal>Let’s make the path clear.</h2>
        <a class="contact-button" data-reveal href="mailto:hello@baylinelegal.ae?subject=Confidential%20consultation%20request&body=Hello%20Bayline%20Legal%2C%0A%0AI%27d%20like%20to%20discuss%3A%0A%0AMy%20preferred%20contact%20details%20are%3A%0A">
          Request a consultation <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer>
      <div class="footer-top">
        <a class="brand footer-brand" href="#top">
          <svg viewBox="0 0 38 38" aria-hidden="true"><path d="M5 4h13c9 0 15 5 15 12 0 5-3 8-7 10 5 1 8 4 8 9h-9c0-4-3-6-8-6h-3v6H5V4Zm9 8v9h4c4 0 6-2 6-5s-2-4-6-4h-4Z" /></svg>
          <span>Bayline Legal</span>
        </a>
        <p>Commercial legal counsel for decisive moments.</p>
      </div>
      <div class="footer-grid">
        <div><strong>Visit</strong><p>Business Bay<br />Dubai, United Arab Emirates</p></div>
        <div><strong>Contact</strong><p><a href="mailto:hello@baylinelegal.ae">hello@baylinelegal.ae</a><br /><a href="tel:+97140000000">+971 4 000 0000</a></p></div>
        <div><strong>Explore</strong><p><a href="#expertise">Expertise</a><br /><a href="#approach">Approach</a><br /><a href="#contact">Contact</a></p></div>
      </div>
      <div class="footer-name" aria-hidden="true">BAYLINE</div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Bayline Legal</span><span>Homepage concept</span></div>
    </footer>
  </body>
</html>

<script>
  import '../scripts/home.js';
</script>
