---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactCTA from '../components/ContactCTA.astro';

const services = [
  { title: 'Corporate & commercial', slug: 'corporate-commercial', image: '/images/commercial-agreement.webp', alt: 'A bilingual commercial agreement under review', summary: 'Legal support for company structures, investment, governance and the agreements that keep business moving.', scope: 'Formation · Governance · Transactions' },
  { title: 'Commercial disputes', slug: 'commercial-disputes', image: '/images/team.webp', alt: 'Lawyers reviewing documents and strategy together', summary: 'Early assessment and a practical strategy for negotiation, arbitration or litigation in the UAE.', scope: 'Negotiation · Arbitration · Litigation' },
  { title: 'Real estate & construction', slug: 'real-estate-construction', image: '/images/business-bay.webp', alt: 'Commercial architecture in Dubai Business Bay', summary: 'Commercially grounded advice for property transactions, developments, leases and project claims.', scope: 'Property · Projects · Claims' },
  { title: 'Employment & mobility', slug: 'employment-mobility', image: '/images/counsel.webp', alt: 'Legal advisers in conversation in a Dubai office', summary: 'Clear employment frameworks for businesses managing people, change and cross-border work.', scope: 'Contracts · Policies · Mobility' }
];

const process = [
  { number: '01', title: 'Consultation & understanding', copy: 'We listen first: the decision, the commercial objective, the deadline and the facts that may change the legal position.' },
  { number: '02', title: 'Review & strategy', copy: 'We assess the documents, applicable UAE rules and practical options, then explain the material risks and trade-offs.' },
  { number: '03', title: 'Action & representation', copy: 'We prepare, negotiate or represent with a clear plan, defined responsibilities and direct communication throughout.' },
  { number: '04', title: 'Resolution & follow-through', copy: 'We close the immediate matter and identify the contractual, governance or operational steps that should follow.' }
];

const lawyers = [
  { name: 'Nadia Al Mansoori', role: 'Managing Partner', focus: 'Corporate & commercial', image: '/images/lawyer-nadia.webp' },
  { name: 'Omar Haddad', role: 'Partner', focus: 'Commercial disputes', image: '/images/lawyer-omar.webp' },
  { name: 'Priya Menon', role: 'Counsel', focus: 'Employment & mobility', image: '/images/lawyer-priya.webp' },
  { name: 'Daniel Okafor', role: 'Counsel', focus: 'Real estate & construction', image: '/images/lawyer-daniel.webp' },
  { name: 'Leila Rahman', role: 'Senior Associate', focus: 'Private client', image: '/images/lawyer-leila.webp' },
  { name: 'James Mercer', role: 'Senior Associate', focus: 'International arbitration', image: '/images/lawyer-james.webp' },
  { name: 'Aisha Khan', role: 'Associate', focus: 'Corporate & commercial', image: '/images/lawyer-aisha.webp' },
  { name: 'Karim El-Sayed', role: 'Associate', focus: 'Construction & projects', image: '/images/lawyer-karim.webp' }
];

const testimonials = [
  { quote: 'The team turned a complex shareholder issue into a clear sequence of decisions. We always knew the risk, the options and what needed to happen next.', role: 'Founder', company: 'Dubai technology company' },
  { quote: 'Their contract review was commercially sharp and easy to act on. The final agreement protected the deal without slowing it down.', role: 'Managing Director', company: 'Regional trading group' },
  { quote: 'We received a calm, realistic assessment of the dispute and a strategy that helped us reach a workable settlement before proceedings escalated.', role: 'General Counsel', company: 'Investment business' },
  { quote: 'Bayline coordinated the legal work around our Dubai entry with clarity. Structure, employment and contracts were handled as one connected project.', role: 'Chief Operating Officer', company: 'International consultancy' },
  { quote: 'The advice was direct and practical. Every call ended with clear responsibilities, timing and the commercial point behind each legal step.', role: 'Finance Director', company: 'Construction company' },
  { quote: 'They understood the pressure around the transaction and kept the documents moving without losing sight of the protections that mattered.', role: 'Private investor', company: 'United Arab Emirates' },
  { quote: 'The employment advice balanced the legal position with the reality of managing people across several markets. It was thoughtful and usable.', role: 'People Director', company: 'Regional services group' },
  { quote: 'From the first review to final negotiation, communication was precise and responsive. We could make decisions with confidence.', role: 'Asset Manager', company: 'Dubai real estate business' }
];

const faqs = [
  { question: 'What legal services does a Dubai business law firm provide?', answer: 'A business law firm can advise on company formation, shareholder arrangements, commercial contracts, investment transactions, disputes, real estate, construction and employment matters. The right scope depends on the decision, the parties involved and the UAE rules that apply.' },
  { question: 'When should a company involve a lawyer in a transaction?', answer: 'Ideally, before key terms are agreed. Early legal input can identify structural, payment, liability and exit risks while the commercial position is still flexible. A lawyer can then turn the agreed business terms into documents that are clear and workable.' },
  { question: 'Can a commercial dispute be resolved before court proceedings?', answer: 'Often, yes. The first step is to review the contract, evidence, timeline and commercial objective. That assessment can support negotiation, a formal notice, mediation or arbitration strategy before litigation is considered.' },
  { question: 'Can international businesses get legal advice before entering Dubai?', answer: 'Yes. International companies commonly seek advice on the appropriate UAE structure, ownership and governance, commercial contracts, employment arrangements and the regulatory requirements relevant to their activity.' }
];

const siteUrl = Astro.site ?? new URL('https://dubai-legal-firm.pages.dev');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL('/images/counsel.webp', siteUrl);
const description = 'Commercial legal advice for companies, founders, investors and private clients in Dubai. Corporate transactions, disputes, real estate and employment counsel from Business Bay.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LegalService', 'LocalBusiness'],
      '@id': `${siteUrl}#legal-service`,
      name: 'Bayline Legal',
      url: siteUrl.toString(),
      image: socialImage.toString(),
      description,
      address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressRegion: 'Dubai', addressCountry: 'AE' },
      areaServed: ['Dubai', 'United Arab Emirates'],
      knowsAbout: services.map((service) => service.title)
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } }))
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#063a2d" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23063a2d%22/><path d=%22M20 19h30c19 0 30 9 30 24 0 9-5 16-14 20 10 2 16 9 16 18H62c0-7-5-11-15-11h-8v11H20V19zm19 16v19h8c8 0 13-3 13-10 0-6-5-9-13-9h-8z%22 fill=%22white%22/></svg>" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AE" />
    <meta property="og:title" content="Bayline Legal | Dubai Business Law Firm" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Bayline Legal | Dubai Business Law Firm" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>Dubai Business Law Firm | Bayline Legal, Business Bay</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader isHome />

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img class="hero-image" src="/images/counsel.webp" alt="Two legal advisers discussing a business matter overlooking Dubai Business Bay" fetchpriority="high" />
        <div class="hero-scrim"></div>
        <div class="hero-copy">
          <h1 id="hero-title">Dubai business law.<br />Clear next steps.</h1>
          <p>Commercial legal advice for companies, founders, investors and private clients navigating decisions in the UAE.</p>
          <a class="primary-action primary-action--light" href="/book-consultation/">Discuss your matter <svg class="action-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg></a>
        </div>
        <div class="hero-facts" aria-label="Firm overview">
          <p><strong>Business Bay</strong><span>Dubai, UAE</span></p>
          <p><strong>Commercial focus</strong><span>Transactions · Disputes · Property</span></p>
          <p><strong data-dubai-time>Dubai · GST</strong><span>Local time</span></p>
        </div>
      </section>

      <section class="proof" aria-label="Firm experience">
        <div class="proof-intro"><span>Experience in view</span><strong>Clear advice, measured by the work.</strong></div>
        <div class="proof-stat"><strong><span data-count="25">25</span>+</strong><span>Combined years<br />of legal experience</span></div>
        <div class="proof-stat"><strong><span data-count="200">200</span>+</strong><span>Matters successfully<br />resolved</span></div>
        <div class="proof-stat"><strong><span data-count="98">98</span>%</strong><span>Client satisfaction<br />rate</span></div>
      </section>

      <section class="position" id="about" aria-labelledby="position-title">
        <div class="position-note" data-reveal><p>Legal advice should make the commercial decision easier to see, explain and act on.</p><img src="/images/commercial-agreement.webp" alt="A bilingual commercial agreement being reviewed" loading="lazy" /></div>
        <div class="position-answer">
          <h2 id="position-title" data-reveal>Counsel for the decision.</h2>
          <p data-reveal>Bayline Legal is a Dubai business law firm advising on corporate transactions, commercial disputes, real estate, construction and employment matters. We begin with the outcome you need, identify the legal and commercial risks, and set out the next practical steps.</p>
          <a class="primary-action primary-action--green" data-reveal href="/book-consultation/">Book a consultation <svg class="action-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg></a>
        </div>
      </section>

      <section class="services" id="services" aria-labelledby="services-title">
        <div class="services-intro"><h2 id="services-title">Business law.<br />Dubai focus.</h2><p>Connected advice for the contracts, relationships, property and people behind a business.</p></div>
        <div class="service-bento">
            {services.map((service) => <a class="service-item" href={`/practice-areas/${service.slug}/`} aria-label={`Explore ${service.title}`} data-service>
              <img class="service-image" src={service.image} alt={service.alt} loading="lazy" />
              <div class="service-copy"><strong>{service.scope}</strong><h3>{service.title}</h3><p>{service.summary}</p></div>
              <span class="service-link" aria-hidden="true"><svg class="action-icon" viewBox="0 0 20 20"><path d="M5 15 15 5M7 5h8v8" /></svg></span>
            </a>)}
        </div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="process-visual"><img src="/images/team.webp" alt="Legal advisers discussing a commercial matter" loading="lazy" /><div class="process-shade"></div><div class="process-copy"><span>Our process</span><h2 id="process-title">Clear steps. Direct action.</h2><p>From first review to resolution, each stage has a clear purpose, owner and next step.</p></div></div>
        <div class="process-steps">
          {process.map((step) => <article class="process-step" data-process-step><span>{step.number}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></article>)}
        </div>
      </section>

      <section class="lawyers" id="lawyers" aria-labelledby="lawyers-title">
        <div class="lawyers-heading"><span>Meet the lawyers</span><h2 id="lawyers-title">The lawyers behind the advice.</h2><p>Direct access to experienced counsel, with the right practice focus brought into each matter.</p></div>
        <div class="lawyer-grid">
          {lawyers.map((lawyer) => <a class="lawyer-card" href={`/lawyers/${lawyer.name.toLowerCase().replaceAll(' ', '-').replace('al-', 'al-')}/`} data-image-reveal><img src={lawyer.image} alt={`${lawyer.name}, ${lawyer.role}`} loading="lazy" /><div class="lawyer-scrim"></div><div class="lawyer-meta"><h3>{lawyer.name}</h3><p>{lawyer.role}</p><span>{lawyer.focus}</span></div></a>)}
        </div>
      </section>

      <section class="approach" id="approach" aria-labelledby="approach-title">
        <div class="approach-heading"><h2 id="approach-title" data-reveal>Direct advice.<br />Business view.</h2><p data-reveal>You work with the lawyer responsible for the matter. Advice is written in plain language and connected to the deadline, risk and business objective.</p></div>
        <div class="approach-collage">
          <div class="collage-large" data-image-reveal><img src="/images/team.webp" alt="A legal team reviewing contracts and plans around a table" loading="lazy" /></div>
          <div class="collage-small" data-image-reveal><img src="/images/business-bay.webp" alt="Green glass architecture along the Dubai canal in Business Bay" loading="lazy" /></div>
          <div class="approach-principles">
            <p data-reveal><strong>Understand the position</strong><span>We review the facts, documents, parties and commercial objective.</span></p>
            <p data-reveal><strong>Define the options</strong><span>You see the available routes, material risks and likely trade-offs.</span></p>
            <p data-reveal><strong>Move with clarity</strong><span>We agree the action plan, responsibility and timing.</span></p>
          </div>
        </div>
      </section>

      <section class="place" aria-labelledby="place-title">
        <img src="/images/business-bay.webp" alt="Business Bay architecture and the Dubai skyline" loading="lazy" /><div class="place-scrim"></div>
        <div class="place-copy"><h2 id="place-title">Business Bay.<br />Global outlook.</h2><p>Dubai-based counsel for matters that cross industries, jurisdictions and time zones.</p></div>
      </section>

      <section class="testimonials" aria-labelledby="testimonials-title">
        <div class="testimonials-heading"><div><span>Client perspectives</span><h2 id="testimonials-title">Clarity people remember.</h2></div><p>What clients value most is advice they can understand, use and trust when the decision matters.</p><div class="carousel-controls"><button type="button" data-carousel-prev aria-label="Show previous testimonials">←</button><button type="button" data-carousel-next aria-label="Show next testimonials">→</button></div></div>
        <div class="testimonial-track" data-carousel-track tabindex="0" aria-label="Client testimonials">
          {testimonials.map((testimonial) => <article class="testimonial-card"><span aria-hidden="true">“</span><blockquote>{testimonial.quote}</blockquote><div class="testimonial-author"><strong>{testimonial.role}</strong><small>{testimonial.company}</small></div></article>)}
        </div>
      </section>

      <section class="faq" id="faq" aria-labelledby="faq-title">
        <div class="faq-intro"><h2 id="faq-title">Dubai law.<br />Clear answers.</h2><p>Brief answers to common questions from businesses and investors. Specific advice depends on the facts of each matter.</p></div>
        <div class="faq-list">
          {faqs.map((faq, index) => <details data-faq open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}
        </div>
      </section>

      <ContactCTA />
    </main>

    <SiteFooter isHome />
  </body>
</html>

<script>
  import '../scripts/home.js';
</script>
